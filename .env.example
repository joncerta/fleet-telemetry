# Copia a .env (ignorado por git). Todos los valores son placeholders solo para local.

# Superusuario del contenedor timescaledb. Solo migra (db:migrate); los servicios no lo usan.
POSTGRES_USER=fleet
# Contraseña del superusuario del contenedor.
POSTGRES_PASSWORD=change-me-local-only
# Conexión del superusuario, solo para pnpm db:migrate. La contraseña debe coincidir con POSTGRES_PASSWORD.
DATABASE_ADMIN_URL=postgres://fleet:change-me-local-only@127.0.0.1:5432/fleet

# Contraseña del rol fleet_app (DML); db:migrate le da login con este valor.
FLEET_APP_PASSWORD=change-me-local-only-app
# Conexión de los servicios (rol fleet_app). La contraseña debe coincidir con FLEET_APP_PASSWORD.
DATABASE_URL=postgres://fleet_app:change-me-local-only-app@127.0.0.1:5432/fleet

# Contraseña del rol fleet_ro (solo SELECT); db:migrate le da login con este valor.
FLEET_RO_PASSWORD=change-me-local-only-ro
# Conexión de solo lectura (tests de permisos, conteos de k6, verificación). La contraseña debe coincidir con FLEET_RO_PASSWORD.
DATABASE_RO_URL=postgres://fleet_ro:change-me-local-only-ro@127.0.0.1:5432/fleet

# Tope de espera por locks (lock_timeout) en db:migrate y db:rollback, en ms (1000-60000). Opcional; por defecto 8000.
# Si se agota, el error pide reintentar en una ventana de menos carga.
DB_MIGRATE_LOCK_TIMEOUT_MS=8000

# Brokers Kafka/Redpanda para servicios en el host (listener externo).
KAFKA_BROKERS=127.0.0.1:19092
# Nivel de logs: debug, info, warn o error.
LOG_LEVEL=info

# Tope del apagado ordenado de cada servicio (SIGTERM/SIGINT), en ms (1000-120000). Opcional; por defecto 15000.
# Debe ser menor que el periodo de gracia del orquestador, o este mata el proceso antes.
SHUTDOWN_TIMEOUT_MS=15000

# --- ingest-gateway (pnpm dev) ---
# Dirección y puerto HTTP. Por defecto 127.0.0.1:4001 (solo la máquina local); en contenedor se usa 0.0.0.0.
INGEST_GATEWAY_HOST=127.0.0.1
INGEST_GATEWAY_PORT=4001
# Tope del cuerpo de una petición, en bytes (1024-10485760). Opcional; por defecto 1048576 (1 MB). Superarlo responde 413.
INGEST_GATEWAY_BODY_LIMIT_BYTES=1048576
# Saltos de proxy de confianza delante del gateway (0-5): el ALB cuenta como 1. Con 0 se ignora X-Forwarded-For y la IP es la
# de la conexión. Detrás de un balanceador debe ser >= 1, o la IP de todo cliente es la del balanceador y los límites por IP se
# vuelven globales. Solo es seguro si el gateway es alcanzable ÚNICAMENTE a través del proxy (grupo de seguridad): si no, un
# cliente puede falsear su IP. Opcional; por defecto 0.
INGEST_GATEWAY_TRUSTED_PROXY_HOPS=0
# Tope ALTO por IP contra floods: máximo de peticiones (todas, también las aceptadas) por ventana, antes de autenticar.
# Opcional; por defecto 6000 peticiones por 60000 ms. Al pasarse responde 429 con Retry-After.
INGEST_GATEWAY_RATE_LIMIT_MAX=6000
INGEST_GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# Límite por IP contra la fuerza bruta de tokens: máximo de fallos de autenticación (401) por ventana (1-1000000) y ventana en
# ms (1000-3600000). Solo cuenta los 401 y solo cambia la respuesta a un token INVÁLIDO (429 con Retry-After en vez de 401): un
# token válido pasa siempre, aunque su IP (CGNAT) haya superado el límite. Opcional; por defecto 20 por 60000 ms.
INGEST_GATEWAY_AUTH_FAILURE_LIMIT_MAX=20
INGEST_GATEWAY_AUTH_FAILURE_LIMIT_WINDOW_MS=60000
# Rate limit por dispositivo (identidad del token), después de autenticar: máximo de lotes por ventana (1-1000000) y
# ventana en ms (1000-3600000). Opcional; por defecto 60 por 60000 ms. Al pasarse responde 429 con Retry-After.
INGEST_GATEWAY_DEVICE_RATE_LIMIT_MAX=60
INGEST_GATEWAY_DEVICE_RATE_LIMIT_WINDOW_MS=60000
# Caché de tokens de dispositivo, en memoria de cada réplica. TTL de un token válido en ms (0-300000, 0 = sin caché):
# la revocación de un dispositivo tarda como máximo este tiempo en aplicarse. Opcional; por defecto 30000.
INGEST_GATEWAY_TOKEN_CACHE_TTL_MS=30000
# TTL de un token desconocido o revocado en ms (0-300000). Más corto que el anterior. Opcional; por defecto 5000.
INGEST_GATEWAY_TOKEN_CACHE_NEGATIVE_TTL_MS=5000
# Tope de entradas de cada caché de tokens (1-1000000). Opcional; por defecto 10000.
INGEST_GATEWAY_TOKEN_CACHE_MAX_ENTRIES=10000
# Consultas de autenticación a la base en vuelo como máximo (1-100), por debajo de la caché (los aciertos no cuentan). Es también el
# tamaño del pool de autenticación. Por encima, el lote responde 503 con Retry-After sin tocar el pool y sin contar como 401.
# Opcional; por defecto 8.
INGEST_GATEWAY_MAX_IN_FLIGHT_AUTH_LOOKUPS=8
# Cuánto puede adelantarse recordedAt de un punto a la hora del servidor, en ms (0-3600000). Pasado ese margen el punto
# se rechaza con future_timestamp. Opcional; por defecto 300000 (5 min).
INGEST_GATEWAY_FUTURE_TOLERANCE_MS=300000
# Antigüedad máxima de recordedAt, en ms (3600000-7776000000: de 1 hora a 90 días, la retención de telemetry). Un punto más
# viejo se rechaza con stale_timestamp (rejected del ACK y telemetry.dlq). Sin cota, un token válido crearía un chunk por cada
# fecha distinta. Opcional; por defecto 604800000 (7 días, el umbral de compresión).
INGEST_GATEWAY_MAX_AGE_MS=604800000
# Tamaño máximo de UN punto serializado, en bytes (512-65536). Más grande se rechaza como invalid_schema y a la DLQ va solo el
# inicio del punto con su tamaño original. Opcional; por defecto 8192.
INGEST_GATEWAY_MAX_POINT_BYTES=8192
# Tiempo máximo de cada publicación en Kafka, en ms (500-60000). Si se agota, el lote responde 503 y el móvil lo reintenta.
# Opcional; por defecto 8000.
INGEST_GATEWAY_PUBLISH_TIMEOUT_MS=8000
# Reintentos del productor de Kafka por envío, con backoff y jitter (1-10; el productor idempotente exige al menos 1).
# Opcional; por defecto 3.
INGEST_GATEWAY_KAFKA_RETRIES=3
# Envíos a Kafka en vuelo como máximo (1-10000), contando los que ya vencieron su timeout y siguen en kafkajs. Por encima, el lote
# responde 503 con Retry-After sin llamar a kafkajs. Opcional; por defecto 256.
INGEST_GATEWAY_MAX_IN_FLIGHT_PUBLICATIONS=256

# --- processor (pnpm dev) ---
# Consumer group de telemetry.raw (1-128 caracteres de A-Za-z0-9._-). Las réplicas lo comparten. Opcional; por defecto processor.
PROCESSOR_CONSUMER_GROUP=processor
# Intentos totales por operación de persistencia ante un fallo transitorio de la base, el primero incluido (1-20).
# Agotados no van a la DLQ (es una caída de infraestructura): el error sube, no se confirma el offset y kafkajs reentrega.
# Opcional; por defecto 5.
PROCESSOR_MAX_ATTEMPTS=5
# Backoff exponencial (x2) con jitter entre reintentos: espera inicial en ms (10-60000) y tope en ms (10-300000, mayor o
# igual que la inicial). Opcional; por defecto 200 y 5000.
PROCESSOR_RETRY_INITIAL_DELAY_MS=200
PROCESSOR_RETRY_MAX_DELAY_MS=5000
# Mensajes por tramo de un lote de Kafka (1-1000): cada tramo es un INSERT; al persistirlo se resuelve su offset y late
# el heartbeat. Opcional; por defecto 500.
PROCESSOR_INSERT_CHUNK_SIZE=500
# Tiempo máximo de la publicación en telemetry.dlq, en ms (500-60000). Si se agota, no se confirma el offset del tramo.
# Opcional; por defecto 8000.
PROCESSOR_DLQ_PUBLISH_TIMEOUT_MS=8000
# Tiempo máximo de la publicación en vehicle.state y fleet.alerts, en ms (500-60000). Si se agota, no se confirma el offset del tramo:
# se reentrega y se republica el estado vigente (los consumidores descartan los repetidos por seq). Opcional; por defecto 8000.
PROCESSOR_EVENTS_PUBLISH_TIMEOUT_MS=8000
# Minutos detenido (contra la hora del fix GPS) dentro de una zona crítica para levantar la alerta critical_zone_stop (1-1440). El umbral
# es inclusivo. Opcional; por defecto 20.
ALERT_CRITICAL_STOP_MINUTES=20
# Detención de un vehículo: un punto con velocidad MENOR que este valor (m/s, 0-10) está detenido. Opcional; por defecto 0.5.
STOP_SPEED_THRESHOLD_MPS=0.5
# Si el punto no trae velocidad: un desplazamiento MENOR que este valor (m, 0-1000) respecto del punto previo cuenta como detenido.
# Opcional; por defecto 15.
STOP_DISPLACEMENT_THRESHOLD_M=15

# --- fleet-api (pnpm dev) ---
# Dirección y puerto HTTP. Por defecto 127.0.0.1:4002 (solo la máquina local); en contenedor se usa 0.0.0.0.
FLEET_API_HOST=127.0.0.1
FLEET_API_PORT=4002
# Secreto con el que se firma la cookie de sesión (HMAC-SHA256). Obligatorio, de AL MENOS 32 bytes: con uno más corto el servicio no arranca.
# Lo comparten fleet-api (emite la cookie) y el agente (la valida): debe ser el mismo. Placeholder solo para local; en AWS sale de Secrets Manager.
SESSION_SECRET=change-me-local-only-session-secret-0123456789
# Vida de una sesión desde el login, en horas (1-720). Opcional; por defecto 12.
SESSION_TTL_HOURS=12
# Orígenes de la web autorizados a llamar a la API con la cookie de sesión (CORS con credenciales), separados por comas. Cada uno con la forma
# esquema://host[:puerto], sin ruta ni comodín (con credenciales un * no vale). Opcional; por defecto http://localhost:3000.
FLEET_API_CORS_ORIGINS=http://localhost:3000
# Atributo Secure de la cookie de sesión (true o false). Solo false en local (http): con TLS debe ser true. Opcional; por defecto false.
FLEET_API_COOKIE_SECURE=false
# Latido del stream SSE (el SSE llega en el paso siguiente), en ms (1000-30000). El idle timeout del ALB en Terraform es de 120 s y exige al menos
# 2 latidos de margen, por eso el máximo es 30000. Opcional; por defecto 15000.
SSE_HEARTBEAT_MS=15000
# Saltos de proxy de confianza delante de fleet-api (0-5): el ALB cuenta como 1. Con 0 se ignora X-Forwarded-For y la IP es la de la conexión.
# Detrás de un balanceador debe ser >= 1, o los límites por IP se vuelven globales. Solo es seguro si la API es alcanzable ÚNICAMENTE a través
# del proxy (grupo de seguridad). Opcional; por defecto 0.
FLEET_API_TRUSTED_PROXY_HOPS=0
# Tope ALTO por IP contra floods: máximo de peticiones por ventana (1-1000000) y ventana en ms (1000-3600000). Opcional; por defecto 600 por 60000 ms.
FLEET_API_RATE_LIMIT_MAX=600
FLEET_API_RATE_LIMIT_WINDOW_MS=60000
# Login: máximo de FALLOS por ventana (1-1000000), contados por IP y por correo (el correo, hasheado), y ventana en ms (1000-86400000).
# Superado cualquiera de los dos: 429 con Retry-After. Opcional; por defecto 10 por 900000 ms (15 min).
FLEET_API_LOGIN_FAILURE_LIMIT_MAX=10
FLEET_API_LOGIN_FAILURE_LIMIT_WINDOW_MS=900000
# Canje de código de vinculación (sin sesión): máximo de códigos inválidos por IP y ventana. El código tiene 40 bits, así que el límite es estricto.
# Opcional; por defecto 10 por 900000 ms (15 min).
FLEET_API_PAIR_FAILURE_LIMIT_MAX=10
FLEET_API_PAIR_FAILURE_LIMIT_WINDOW_MS=900000
# Vida de un código de vinculación, en minutos (1-60). Opcional; por defecto 10.
FLEET_API_PAIRING_CODE_TTL_MINUTES=10

# --- datos de demo (pnpm db:seed, solo local) ---
# Contraseña de los usuarios de demo operador@norte.test y operador@sur.test (12-256 caracteres). Placeholder solo para local:
# se guarda únicamente su hash scrypt y cambiarla después NO cambia la de los usuarios ya sembrados. Obligatoria para db:seed.
SEED_USER_PASSWORD=change-me-local-only-user

# --- agent (pnpm dev) ---
# Dirección y puerto HTTP. Por defecto 127.0.0.1:4003 (solo la máquina local); en contenedor se usa 0.0.0.0.
AGENT_HOST=127.0.0.1
AGENT_PORT=4003
# URL base de fleet-api (http o https, sin credenciales). El agente la llama con la cookie de sesión del usuario, detrás de un circuit breaker.
# Opcional; por defecto http://127.0.0.1:4002. El SESSION_SECRET del agente es el mismo de fleet-api (variable SESSION_SECRET, más arriba).
FLEET_API_URL=http://127.0.0.1:4002
# Orígenes de la web autorizados a llamar al agente con la cookie de sesión (CORS con credenciales), separados por comas. Cada uno con la forma
# esquema://host[:puerto], sin ruta ni comodín. Opcional; por defecto http://localhost:3000.
AGENT_CORS_ORIGINS=http://localhost:3000
# Proveedor del modelo: anthropic (Claude real) o scripted (modelo con guion, determinista, para tests y e2e; no usa red ni API key).
# Opcional; por defecto anthropic.
AGENT_MODEL_PROVIDER=anthropic
# Modelo de Anthropic. Opcional; por defecto claude-sonnet-5-5.
AGENT_MODEL=claude-sonnet-5-5
# API key de Anthropic. Obligatoria con AGENT_MODEL_PROVIDER=anthropic; con scripted no se usa. Secreto: nunca en el repo ni en logs.
ANTHROPIC_API_KEY=
# Pasos (llamada al modelo + herramientas) permitidos por pregunta (1-20) y tiempo total de una pregunta en ms (1000-300000).
# Opcionales; por defecto 6 y 60000. Superados, el chat responde 503 (pasos) o 504 (tiempo).
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_MS=60000
# Saltos de proxy de confianza delante del agente (0-5): el ALB cuenta como 1. Con 0 se ignora X-Forwarded-For. Opcional; por defecto 0.
AGENT_TRUSTED_PROXY_HOPS=0
# Tope ALTO por IP contra floods (todas las rutas salvo /v1/chat y la salud): peticiones por ventana (1-1000000) y ventana en ms (1000-3600000).
# Opcional; por defecto 600 por 60000 ms.
AGENT_RATE_LIMIT_MAX=600
AGENT_RATE_LIMIT_WINDOW_MS=60000
# Preguntas por USUARIO y ventana en POST /v1/chat (cada una cuesta una llamada al modelo): máximo (1-1000000) y ventana en ms (1000-3600000).
# Superado: 429 con Retry-After. Opcional; por defecto 20 por 60000 ms.
AGENT_USER_RATE_LIMIT_MAX=20
AGENT_USER_RATE_LIMIT_WINDOW_MS=60000
# Circuit breaker hacia fleet-api. Tiempo máximo de una llamada en ms (100-60000); porcentaje de fallos que lo abre (1-100); llamadas mínimas
# dentro de la ventana antes de poder abrirse (1-1000); espera abierto antes de probar de nuevo (halfOpen) en ms (100-600000); ventana estadística
# en ms (1000-600000). Los 4xx de fleet-api no cuentan como fallo. Opcionales; por defecto 3000, 50, 5, 15000 y 10000.
AGENT_FLEET_API_TIMEOUT_MS=3000
AGENT_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
AGENT_BREAKER_VOLUME_THRESHOLD=5
AGENT_BREAKER_RESET_TIMEOUT_MS=15000
AGENT_BREAKER_ROLLING_WINDOW_MS=10000
