# Variables de la web (Next las lee de apps/web/.env*). Todas son públicas: se incrustan en el bundle del navegador al compilar,
# así que aquí nunca va nada sensible. Se validan con zod al arrancar (src/config/public-env.ts): un valor inválido detiene la app.

# URL de fleet-api (REST + SSE). La sesión es una cookie HttpOnly de esa API: la web nunca ve ni guarda tokens.
# Debe usar el mismo host que la web (localhost con localhost) para que el navegador envíe la cookie SameSite=Lax.
# Opcional; por defecto http://localhost:4002.
NEXT_PUBLIC_FLEET_API_URL=http://localhost:4002

# URL del agente IA (POST /v1/chat y GET /health). Usa la misma cookie de sesión que fleet-api: mismo host que la web.
# Opcional; por defecto http://localhost:4003.
NEXT_PUBLIC_AGENT_URL=http://localhost:4003

# Estilo de MapLibre GL. Por defecto OpenFreeMap (gratuito, sin token, con atribución visible). Nunca los tiles públicos de OpenStreetMap.
# Opcional; por defecto https://tiles.openfreemap.org/styles/positron.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- e2e de Playwright (pnpm --filter @fleet/web test:e2e) ---
# No usa variables de este archivo: toma las del .env de la RAÍZ (DATABASE_URL, KAFKA_BROKERS, SEED_USER_PASSWORD). Levanta gateway,
# fleet-api y el agente (modelo con guion) desde dist/ en los puertos 34001/34002/34003, el processor, y la web en 33000.
