{
  "name": "@fleet/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard de monitoreo de la flota (Next.js App Router, MapLibre GL, SSE + Zustand).",
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev --port 3000",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fleet/contracts": "workspace:*",
    "maplibre-gl": "^6.12.0",
    "next": "^16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fleet/dev-data": "workspace:*",
    "@fleet/platform": "workspace:*",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
