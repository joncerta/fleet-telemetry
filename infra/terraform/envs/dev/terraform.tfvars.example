# Copia a terraform.tfvars (ignorado por git). Todos los valores son marcadores: ninguno es un secreto.
# Cada uno marcado "DECISION" depende de una respuesta pendiente del equipo; el plan falla hasta que se definan.

aws_region = "<DECISION: region con MSK Serverless>"
owner      = "<equipo o persona dueña del ambiente>"
# Centro de costos para la etiqueta cost-center.
cost_center = "<centro de costos>"

# Tag inmutable de las imágenes (SHA del commit que publicó el pipeline).
image_tag = "<sha-del-commit>"

# DECISION: ARN del certificado ACM del dominio del ALB (misma región).
certificate_arn = "arn:aws:acm:<region>:<cuenta>:certificate/<id>"

# DECISION: presupuesto mensual del ambiente, en USD, y quién recibe las alertas.
monthly_budget_usd = 0
budget_emails      = ["<correo>"]

alarm_emails = []

# DECISION: origenes https de la web que llamaran a fleet-api con la cookie de sesion (depende del dominio de la web).
fleet_api_cors_origins = ["https://<dominio-de-la-web>"]

# DECISION: URL https del ALB (dominio del certificado) con la que el agente llama a fleet-api.
agent_fleet_api_url = "https://<dominio-del-alb>"

# La API key de Anthropic NO va aqui: se pasa por TF_VAR_anthropic_api_key solo al crear o rotar (variable efimera).

# Primer despliegue: 0 en los tres servicios hasta que existan los topicos (ver el README, "Orden de despliegue").
gateway_desired_count   = 0
processor_desired_count = 0
fleet_api_desired_count = 0
agent_desired_count     = 0
